CREATE TABLE categoryEntity (
    id TEXT NOT NULL PRIMARY KEY,
    nameResId TEXT NOT NULL,
    type TEXT NOT NULL,
    icon TEXT NOT NULL,
    color TEXT NOT NULL,
    priority INTEGER NOT NULL,
    isDefault INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

selectAll:
SELECT * FROM categoryEntity WHERE deleted_at IS NULL ORDER BY priority ASC;

insertCategory:
INSERT OR REPLACE INTO categoryEntity(id, nameResId, type, icon, color, priority, isDefault, created_at, updated_at, deleted_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

softDeleteCategory:
UPDATE categoryEntity SET deleted_at = ? WHERE id = ?;
